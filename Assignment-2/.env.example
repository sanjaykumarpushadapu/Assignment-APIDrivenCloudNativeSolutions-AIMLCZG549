# Shared fallback for both tasks. Task-specific model names take priority.
MODEL_NAME=google/flan-t5-base
# Fine-tuned classifier checkpoint, saved locally by scripts/train_classifier.py.
CLASSIFIER_MODEL_NAME=./artifacts/models/clinic-support
# Use the original base model for summaries and source-grounded answers.
SUMMARIZER_MODEL_NAME=google/flan-t5-base
# Optional task-specific revisions override MODEL_REVISION when set.
CLASSIFIER_MODEL_REVISION=
SUMMARIZER_MODEL_REVISION=
# Blank pins our verified baseline automatically; other Hub models use their
# default revision. Set an explicit commit SHA for a reproducible Hub model.
MODEL_REVISION=

# cpu, mps (Apple GPU), cuda (NVIDIA GPU), or auto.
MODEL_DEVICE=cpu
# auto selects CUDA, then Apple MPS, then CPU. Override to force a device.
TRAINING_DEVICE=auto
# Relative paths are resolved from Assignment-2, regardless of the working folder.
MODEL_CACHE_DIR=artifacts/huggingface
MODEL_MAX_INPUT_TOKENS=512
CLASSIFICATION_MAX_NEW_TOKENS=32
# Maximum generated tokens for each handoff summary.
SUMMARY_MAX_NEW_TOKENS=128
# Maximum generated tokens for each source-grounded answer.
ANSWER_MAX_NEW_TOKENS=160
# true uses cached/local files only and fails if a model is unavailable locally.
MODEL_LOCAL_FILES_ONLY=false

# Local knowledge retrieval uses transformer embeddings; answer generation is
# configured separately in a later step.
RETRIEVAL_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Pin a repository commit for repeatable retrieval results. Update this with the model name.
RETRIEVAL_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RETRIEVAL_DEVICE=auto
RETRIEVAL_MAX_INPUT_TOKENS=256
RETRIEVAL_TOP_K=3
# Provisional abstention floor for /chat; similarity is not a confidence score.
RETRIEVAL_MIN_SCORE=0.20
KNOWLEDGE_CHUNKS_PATH=data/knowledge/chunks.jsonl
