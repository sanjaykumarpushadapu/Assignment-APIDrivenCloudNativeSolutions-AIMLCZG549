DIABETES_DATASET_PATH=data/raw/diabetes_012_health_indicators_BRFSS2015.csv
DIABETES_OUTPUT_DIR=data/processed
DIABETES_REPORT_DIR=data/outputs

# GCP-backed API layer -- Cloud Composer / Airflow REST API / Cloud Monitoring.
# Run `gcloud auth application-default login` before using the GCP-backed
# endpoints. Keep the credential path out of this file; the Google libraries
# use Application Default Credentials automatically.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCP_COMPOSER_ENVIRONMENT=diabetes-risk-env
# Local Airflow REST calls impersonate this runtime identity to mint an
# audience-bound IAP token. The caller needs roles/iam.serviceAccountTokenCreator.
GCP_IAP_SERVICE_ACCOUNT=diabetes-risk-runtime@diabetes-risk-group49.iam.gserviceaccount.com

# Same bucket name used by the DAG (dags/diabetes_risk_pipeline.py) and the
# model/dataset API reads through the Cloud Storage API.
DIABETES_GCS_BUCKET=diabetes-risk-group49-pipeline

# Dashboard (src/diabetes_risk/dashboard/app.py) -- where it fetches live
# data from. Defaults to the API's documented local port (see README.md
# "Run the API"); override if you run the API elsewhere.
DIABETES_API_BASE_URL=http://127.0.0.1:9000

# API (src/diabetes_risk/api/main.py) -- CORS origin allowed to call it.
# "*" (default) is fine for local development/demo, not production.
DASHBOARD_ORIGIN=* 