DIABETES_DATASET_PATH=data/raw/diabetes_012_health_indicators_BRFSS2015.csv
DIABETES_OUTPUT_DIR=data/processed
DIABETES_REPORT_DIR=data/outputs

# API layer (Person 4) -- Cloud Composer / Airflow REST API / Cloud Monitoring.
# Leave blank locally; only required once gcp_service.py is implemented and
# you are running the API against a live Composer environment.
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_COMPOSER_ENVIRONMENT=
GOOGLE_APPLICATION_CREDENTIALS=

# Same bucket name the DAG uses (dags/diabetes_risk_pipeline.py) -- read by
# local_service.py via the Cloud Storage API once implemented.
DIABETES_GCS_BUCKET=
